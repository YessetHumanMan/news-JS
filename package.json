{
    "name": "NewsJS",
    "version": "1.0.0",
    "description": "Responsive TypeScript news explorer powered by News API",
    "main": "webpack.config.js",
    "scripts": {
        "start": "webpack serve --open --config ./webpack.config.js --env mode=dev",
        "build": "webpack --config ./webpack.config.js --env mode=prod",
        "typecheck": "tsc --noEmit",
        "lint": "eslint \"src/**/*.ts\" --no-error-on-unmatched-pattern",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "validate": "npm run typecheck && npm run lint && npm run format:check && npm run build",
        "deploy": "npm run build && gh-pages -d dist"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/YessetHumanMan/news-JS.git"
    },
    "keywords": [
        "typescript",
        "webpack",
        "news-api",
        "responsive"
    ],
    "author": "YessetHumanMan",
    "license": "ISC",
    "homepage": "https://yessethumanman.github.io/news-JS/",
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "clean-webpack-plugin": "^4.0.0",
        "copy-webpack-plugin": "^12.0.2",
        "css-loader": "^6.10.0",
        "dotenv-webpack": "^8.0.1",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-prettier": "^5.1.3",
        "gh-pages": "^6.3.0",
        "html-webpack-plugin": "^5.6.0",
        "prettier": "3.2.5",
        "style-loader": "^3.3.4",
        "ts-loader": "^9.6.2",
        "typescript": "^5.9.3",
        "webpack": "^5.90.1",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.0.0",
        "webpack-merge": "^5.10.0"
    }
}
